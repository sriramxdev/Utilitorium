---
import ToolCard from './ToolCard.astro';
import aiNotes from '../pages/tools/ai-notes/notebooklm-note-renderer.json';
import media from '../pages/tools/media/realesrgan-video-upscaler.json';
import parsers from '../pages/tools/parsers/pdf-json-converter.json';
import visits from '../data/visits.json';

const allTools = [aiNotes, media, parsers];
const featuredTools = [...allTools].sort((a, b) => (visits[b.id] ?? 0) - (visits[a.id] ?? 0)).slice(0, 5);
---

<section id="featured" class="mx-auto w-full max-w-screen-2xl scroll-mt-24 px-4 py-12 sm:px-6 sm:py-14 lg:px-8 xl:px-10">
	<div class="mb-7 flex flex-col items-start gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow mb-3">01 / Signal</p><h2 class="font-heading text-4xl font-bold text-primary">Most visited</h2></div><span class="text-base text-secondary">Top 5 by community usage</span></div>
	<div id="featured-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">{featuredTools.map((tool, index) => <ToolCard tool={tool} featured={index === 0} visits={visits[tool.id] ?? 0} />)}</div>
</section>

<script>
	import { getVisitCount, recordVisit } from '../utils/visitTracker';
	import seedVisits from '../data/visits.json';

	const getVisits = (id: string) => getVisitCount(id, seedVisits[id as keyof typeof seedVisits] ?? 0);

	document.querySelectorAll<HTMLElement>('[data-visit-count]').forEach((count) => {
		const id = count.dataset.visitCount;
		if (id) count.textContent = `${getVisits(id)} visits`;
	});

	const featuredGrid = document.querySelector('#featured-grid');
	const sortFeatured = () => {
		if (!featuredGrid) return;
		[...featuredGrid.children]
			.sort((a, b) => getVisits((b as HTMLElement).dataset.toolId ?? '') - getVisits((a as HTMLElement).dataset.toolId ?? ''))
			.forEach((card) => featuredGrid.append(card));
	};
	sortFeatured();

	document.querySelectorAll<HTMLElement>('[data-visit-tool]').forEach((link) => {
		link.addEventListener('click', () => {
			const id = link.dataset.visitTool;
			if (!id) return;
			recordVisit(id);
			const count = document.querySelector<HTMLElement>(`[data-visit-count="${id}"]`);
			if (count) count.textContent = `${getVisits(id)} visits`;
			sortFeatured();
		});
	});
</script>
