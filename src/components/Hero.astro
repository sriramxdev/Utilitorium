---
import home from '../data/home.json';
---

<section id="hero" class="mx-auto w-full max-w-screen-2xl px-4 pb-16 pt-24 sm:px-6 sm:pb-24 sm:pt-32 lg:px-8 xl:px-10">
	<div class="max-w-4xl">
		<p class="eyebrow mb-5"><span class="status-dot"></span> {home.status}</p>
		<h1 class="font-heading text-5xl font-bold leading-[.92] tracking-tight text-primary sm:text-7xl lg:text-8xl">Build less.<br /><span class="text-brand-amber">Automate more.</span></h1>
		<p class="mt-8 max-w-3xl text-base leading-7 text-secondary sm:text-lg">{home.description}</p>
		<a href="#featured" class="button-primary mt-8 inline-flex items-center gap-3">Explore the workbench <span aria-hidden="true">↓</span></a>
	</div>
</section>
