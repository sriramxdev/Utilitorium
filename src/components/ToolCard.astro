---
interface Tool {
    id: string;
    name: string;
    description: string;
    category: string;
    icon: string;
    tags: string[];
    url: string;
}

const { tool, featured = false, visits = 0 } = Astro.props as { tool: Tool; featured?: boolean; visits?: number };
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const iconPath = `${baseUrl}${tool.icon.replace(/^\/+/, '')}`;
const toolUrl = `${baseUrl}${tool.url.replace(/^\/+/, '')}`;
---

<article class:list={['tool-card group', { 'featured-card': featured }]} data-tool-id={tool.id}>
    <div class="flex items-start justify-between gap-4">
        <div class="flex min-w-0 items-center gap-3">
            <div class="tool-icon"><img src={iconPath} alt="" width="24" height="24" /></div>
            <h3 class="font-heading text-xl font-bold text-primary">{tool.name}</h3>
        </div>
        <div class="flex items-center gap-3">
            <span class="visit-count text-base text-secondary" data-visit-count={tool.id}>{visits} visits</span>
            <span class="text-lg text-brand-amber transition-transform duration-300 group-hover:translate-x-1">↗</span>
        </div>
    </div>
    <p class="description mt-4 text-base leading-7 text-secondary">{tool.description}</p>
    <div class="mt-5 flex flex-wrap gap-2">
        {tool.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <a class="absolute inset-0" href={toolUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open ${tool.name}`} data-visit-tool={tool.id}></a>
</article>

<script>
    import { fetchViews, incrementViews } from '../utils/visitTracker';

    // 1. Fetch and update view count for all cards on the page
    document.querySelectorAll<HTMLElement>('[data-visit-count]').forEach(async (el) => {
        const toolId = el.getAttribute('data-visit-count');
        if (toolId) {
            const views = await fetchViews(toolId);
            if (views > 0) {
                el.textContent = `${views} visits`;
            }
        }
    });

    // 2. Increment view count on click
    document.querySelectorAll<HTMLAnchorElement>('a[data-visit-tool]').forEach((link) => {
        link.addEventListener('click', () => {
            const toolId = link.getAttribute('data-visit-tool');
            if (toolId) {
                incrementViews(toolId);
            }
        });
    });
</script>