---
import ThemeToggle from './ThemeToggle.astro';

interface Category {
	id: string;
	name: string;
}

const { categories } = Astro.props as { categories: Category[] };
---

<header class="sticky top-3 z-20 mx-auto w-full max-w-screen-2xl px-4 sm:top-4 sm:px-6 lg:px-8 xl:px-10">
	<nav class="glass-panel flex flex-wrap items-center justify-between gap-4 rounded-2xl px-4 py-3 sm:flex-nowrap sm:gap-5 sm:rounded-full sm:px-5" aria-label="Main navigation">
		<a href="/" class="font-heading text-2xl font-bold tracking-wide text-primary">UTILITORIUM<span class="text-brand-amber">.</span></a>
		<div class="hidden items-center gap-7 text-lg text-secondary sm:flex">
			<a class="nav-link" href="/#hero">Home</a>
			<a class="nav-link" href="/#featured">Featured</a>
			<div id="category-menu" class="category-menu relative">
				<button class="nav-link cursor-pointer border-0 bg-transparent p-0 text-lg" type="button" aria-expanded="false" aria-controls="category-dropdown">
					Categories <span class="ml-1 text-brand-amber">⌄</span>
				</button>
				<div id="category-dropdown" class="category-dropdown glass-panel absolute right-0 top-5 w-56 rounded-xl p-2 pt-4 shadow-xl" aria-label="Category links">
					{categories.map((category) => <a class="nav-link block rounded-lg px-3 py-2 text-lg hover:bg-panel-hover" href={`/#${category.id}`}>{category.name}</a>)}
				</div>
			</div>
			<a class="nav-link" href="/#footer">About</a>
		</div>
		<button id="mobile-menu-button" class="theme-toggle sm:hidden" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation menu">
			<span aria-hidden="true">☰</span>
		</button>
		<ThemeToggle />
		<div id="mobile-menu" class="hidden w-full basis-full border-t border-subtle/60 pt-3 sm:hidden">
			<div class="flex flex-col gap-1 text-lg text-secondary">
				<a class="nav-link rounded-lg px-3 py-2" href="/#hero">Home</a>
				<a class="nav-link rounded-lg px-3 py-2" href="/#featured">Featured</a>
				{categories.map((category) => <a class="nav-link rounded-lg px-3 py-2" href={`/#${category.id}`}>{category.name}</a>)}
				<a class="nav-link rounded-lg px-3 py-2" href="/#footer">About</a>
			</div>
		</div>
	</nav>
</header>

<script>
	const categoryMenu = document.querySelector('#category-menu');
	const categoryButton = categoryMenu?.querySelector('button');
	const mobileMenuButton = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
	const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
	let closeTimer: ReturnType<typeof setTimeout> | undefined;

	const closeCategoryMenu = () => {
		if (!categoryButton) return;
		categoryButton.setAttribute('aria-expanded', 'false');
	};

	categoryButton?.addEventListener('click', () => {
		window.clearTimeout(closeTimer);
		const isExpanded = categoryButton.getAttribute('aria-expanded') === 'true';
		categoryButton.setAttribute('aria-expanded', String(!isExpanded));
	});
	categoryMenu?.addEventListener('mouseleave', () => {
		closeTimer = window.setTimeout(closeCategoryMenu, 300);
	});
	categoryMenu?.addEventListener('mouseenter', () => window.clearTimeout(closeTimer));
	categoryMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeCategoryMenu));
	mobileMenuButton?.addEventListener('click', () => {
		if (!mobileMenu) return;
		const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
		mobileMenuButton.setAttribute('aria-expanded', String(!isExpanded));
		mobileMenuButton.setAttribute('aria-label', isExpanded ? 'Open navigation menu' : 'Close navigation menu');
		mobileMenu.classList.toggle('hidden', isExpanded);
	});
	mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
		mobileMenuButton?.setAttribute('aria-expanded', 'false');
		mobileMenuButton?.setAttribute('aria-label', 'Open navigation menu');
		mobileMenu?.classList.add('hidden');
	}));
</script>
