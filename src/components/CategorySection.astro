---
import ToolCard from './ToolCard.astro';

interface Category { id: string; name: string; description: string; number: string }
interface Tool { id: string; name: string; description: string; category: string; icon: string; tags: string[]; url: string }
const { category, tools, visits = {} } = Astro.props as { category: Category; tools: Tool[]; visits?: Record<string, number> };
---

<section id={category.id} class="mx-auto max-w-6xl scroll-mt-24 px-5 py-14">
	<div class="mb-7 flex items-end justify-between gap-5">
		<div><p class="eyebrow mb-3">{category.number} / {category.name}</p><h2 class="font-heading text-4xl font-bold text-primary">{category.name}</h2></div>
		<p class="hidden max-w-xs text-right text-sm leading-6 text-secondary sm:block">{category.description}</p>
	</div>
	<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">{tools.map((tool) => <ToolCard tool={tool} visits={visits[tool.id] ?? 0} />)}</div>
</section>
