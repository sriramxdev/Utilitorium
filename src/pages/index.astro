---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Featured from '../components/Featured.astro';
import Footer from '../components/Footer.astro';
import categories from '../data/categories.json';
import AiNotes from '../components/categories/AiNotes.astro';
import Media from '../components/categories/Media.astro';
import Parsers from '../components/categories/Parsers.astro';
import visits from '../data/visits.json';
---

<Layout>
	<Navbar categories={categories} />
	<main>
		<Hero />
		<Featured />
		<AiNotes visits={visits} />
		<Media visits={visits} />
		<Parsers visits={visits} />
	</main>
	<Footer />
</Layout>
