---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import categories from '../../../data/categories.json';
import toolData from './realesrgan-video-upscaler.json';
---

<Layout>
	<Navbar categories={categories} />
	<main class="mx-auto w-full max-w-screen-2xl px-4 pb-16 pt-20 sm:px-6 lg:px-8 xl:px-10">
		<section class="max-w-4xl">
			<p class="eyebrow mb-4">{toolData.utilityNumber}</p>
			<div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
				<div>
					<h1 class="font-heading text-5xl font-bold leading-none tracking-tight text-primary sm:text-7xl">{toolData.name}</h1>
					<p class="mt-6 text-lg leading-8 text-secondary">{toolData.tagline}</p>
				</div>
				<span class="shrink-0 rounded-full border border-subtle px-4 py-2 text-sm text-secondary">{toolData.version}</span>
			</div>
			<div class="mt-8 flex flex-wrap gap-2">{toolData.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
		</section>
		<section class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
			<div class="glass-panel rounded-2xl p-6"><p class="eyebrow mb-4">About the utility</p><p class="text-lg leading-8 text-secondary">{toolData.about}</p></div>
			<div><p class="eyebrow mb-5">Workflow</p><div class="grid gap-5">{toolData.steps.map((step) => <div class="border-l-2 border-brand-amber pl-5"><h2 class="font-heading text-2xl font-bold text-primary">{step.step}</h2><p class="mt-2 text-base leading-7 text-secondary">{step.desc}</p></div>)}</div></div>
		</section>
	</main>
	<Footer />
</Layout>
